<div class="page-header">
  <div>
    <h1>Products</h1>
    <p>Manage your catalog, pricing and stock levels.</p>
  </div>
  <%= link_to "+ New product", new_product_path, class: "btn btn-primary" %>
</div>

<div class="card flush">
  <% if @products.any? %>
    <table class="table">
      <thead>
        <tr>
          <th>Name</th>
          <th class="num">Price</th>
          <th class="num">Stock</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @products.each do |product| %>
          <tr>
            <td><%= link_to product.name, product, class: "product-name" %></td>
            <td class="num"><%= number_to_currency(product.price) %></td>
            <td class="num">
              <% pill = product.stock_count.to_i.zero? ? "pill-out" : (product.stock_count < 5 ? "pill-low" : "pill-ok") %>
              <span class="pill <%= pill %>"><%= product.stock_count %></span>
            </td>
            <td>
              <div class="actions">
                <%= link_to "View", product, class: "btn btn-sm" %>
                <%= link_to "Edit", edit_product_path(product), class: "btn btn-sm" %>
                <%= button_to "Delete", product, method: :delete, class: "btn btn-sm btn-danger",
                      form: { class: "inline-form", data: { turbo_confirm: "Delete this product?" } } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="empty">No products yet. Create your first one.</div>
  <% end %>
</div>
